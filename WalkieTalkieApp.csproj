<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<RootNamespace>WalkieTalkieApp</RootNamespace>
		<AssemblyName>WalkieTalkieApp</AssemblyName>
		<Platforms>AnyCPU;x64</Platforms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Declara la plataforma mínima: sin esto el analizador emitía ~250 avisos
		     CA1416 y había que silenciarlos con pragmas repartidos por el código. -->
		<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>

		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishTrimmed>false</PublishTrimmed>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

		<Version>2.3.0</Version>
		<Company>TuEmpresa</Company>
		<Product>Walkie Talkie Empresarial</Product>
		<Copyright>Copyright © 2026</Copyright>

		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<Optimize>true</Optimize>
		<!--
		  Estaba en false, y por eso no se emitía [assembly: SupportedOSPlatform("windows")]:
		  el analizador creía que el ensamblado era multiplataforma y avisaba en cada
		  llamada a WinForms. No hay ningún AssemblyInfo.cs manual con el que chocar.
		-->
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<ApplicationIcon>resources\VW_Talk_Logo.ico</ApplicationIcon>
		<!-- Estaba sin enlazar: el manifiesto no se aplicaba. -->
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
		<!-- Copia de los archivos originales; no forma parte de la compilación. -->
		<Compile Remove="_backup_original\**" />
		<EmbeddedResource Remove="_backup_original\**" />
		<None Remove="_backup_original\**" />
		<Compile Remove="resourses\**" />
		<EmbeddedResource Remove="resourses\**" />
		<None Remove="resourses\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NAudio" Version="2.2.1" />
		<!--
		  Microsoft.Extensions.Configuration.* ya no hace falta: la configuración se
		  lee y se escribe con System.Text.Json, que viene incluido en el framework.
		  System.Buffers / System.Memory / System.Runtime.CompilerServices.Unsafe /
		  System.IO.Ports tampoco se usaban.
		-->
	</ItemGroup>

	<ItemGroup>
		<!--
		  Con comodines ya no hay que tocar el .csproj al añadir avatares o sonidos.
		  CopyToPublishDirectory es necesario aparte: al publicar, el .ico declarado
		  en ApplicationIcon no se copiaba y la app se quedaba sin icono de bandeja.
		-->
		<None Include="resources\**\*.*"
		      Exclude="resources\VW_Talk_Logo.ico"
		      CopyToOutputDirectory="PreserveNewest"
		      CopyToPublishDirectory="PreserveNewest" />
		<Content Include="resources\VW_Talk_Logo.ico"
		         CopyToOutputDirectory="PreserveNewest" />
		<None Include="sounds\**\*.*"
		      CopyToOutputDirectory="PreserveNewest"
		      CopyToPublishDirectory="PreserveNewest" />
		<None Update="appsettings.json"
		      CopyToOutputDirectory="PreserveNewest"
		      CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<!--
	  El SDK saca del publicado el archivo declarado en ApplicationIcon, así que se
	  copia a mano. Sin él, la ventana y el icono de la bandeja salen con el icono
	  genérico de Windows.
	-->
	<Target Name="CopiarIconoAlPublicado" AfterTargets="Publish">
		<Copy SourceFiles="resources\VW_Talk_Logo.ico"
		      DestinationFolder="$(PublishDir)resources"
		      SkipUnchangedFiles="true" />
	</Target>
</Project>
